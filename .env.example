# Network: solana-local (default, in-process ledger), solana-devnet or solana
AGENTWALL_NETWORK=solana-local

# Local simulator: memory (pure TypeScript, any OS) or litesvm (real Solana runtime, Linux/macOS)
AGENTWALL_LEDGER=memory

# RPC endpoint for devnet/mainnet (defaults to the public endpoints)
# AGENTWALL_RPC_URL=https://api.devnet.solana.com

# Policy file (defaults to policies/demo.policy.json)
# AGENTWALL_POLICY=policies/demo.policy.json

# Custody wallet keypair (Solana CLI JSON format). Create one with: npm run keygen
# AGENTWALL_KEYPAIR=data/custody-keypair.json

# Admin token for the dashboard and admin API. Random if unset.
# AGENTWALL_ADMIN_TOKEN=

# Agent API keys as agent-id:key pairs. Random if unset.
# AGENTWALL_AGENT_KEYS=research-agent:aw_research_xxx,ops-agent:aw_ops_xxx

# Mount the demo x402 merchants on devnet too (always on for solana-local)
# AGENTWALL_DEMO=1

# Where the audit log is written
AGENTWALL_DATA_DIR=data
PORT=8787

# Only for examples/llm-agent.ts
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
